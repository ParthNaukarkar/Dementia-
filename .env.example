# ════════════════════════════════════════════════════════════════════════════════
# Smriti-NER Cloud AI Engine Configuration
# ════════════════════════════════════════════════════════════════════════════════
# Reports are generated directly via frontier Cloud LLMs using API keys.
# Zero local models to train or run.
#
# Get free Gemini API key: https://aistudio.google.com/app/apikey
# ════════════════════════════════════════════════════════════════════════════════

# Google Gemini (Default recommended: gemini-2.0-flash)
VITE_GEMINI_API_KEY=

# OpenAI (Optional: gpt-4o-mini)
VITE_OPENAI_API_KEY=

# Groq Cloud (Optional: llama-3.3-70b-versatile)
VITE_GROQ_API_KEY=
